EXPECTED_MAINNET_DEPLOYER=
HANDSEL_MAINNET_DEPLOYMENT_ADDRESS=0x51bfB2A08E7680786eD54a00eE4d915Bab6B3867

# Railway API and network-aware Arc RPC indexer.
PORT=8787
APP_ORIGIN=http://localhost:5173,https://www.archandsel.xyz
ARC_NETWORK=mainnet
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
