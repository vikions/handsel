{
  "name": "handsel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "pnpm --filter @handsel/contracts build && pnpm --filter @handsel/server build && pnpm --filter @handsel/frontend build",
    "circle:monitors": "node --env-file-if-exists=.env scripts/setup-circle-event-monitors.mjs",
    "compile": "pnpm --filter @handsel/contracts compile",
    "dev": "pnpm --filter @handsel/frontend build && node scripts/serve-frontend.mjs",
    "dev:vite": "pnpm --filter @handsel/frontend dev",
    "dev:server": "pnpm --filter @handsel/server build && pnpm --filter @handsel/server dev",
    "start:server": "pnpm --filter @handsel/server start",
    "test": "pnpm --filter @handsel/contracts test && pnpm --filter @handsel/server test"
  }
}
